root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.cs]
# 配合仓库现状：文件为 LF（git autocrlf 转换），中文注释为源码一部分
csharp_style_namespace_declarations = block_scoped:suggestion
dotnet_sort_system_directives_first = true
