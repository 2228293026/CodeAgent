<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>codeagent</AssemblyName>
    <RootNamespace>CodeAgent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.4.0</Version>
    <Description>LLM 驱动的编码助手 CLI（支持 OpenAI 兼容协议与 Anthropic Claude）</Description>
    <Authors>HitMargin</Authors>
    <RepositoryUrl>https://github.com/2228293026/CodeAgent</RepositoryUrl>
    <PackageProjectUrl>https://github.com/2228293026/CodeAgent</PackageProjectUrl>
    <!-- 把 commit sha 写进 InformationalVersion（形如 0.4.0+852644f）。
         /diag 的 "Build commit" 读的就是它：版本号逐轮不变，光看版本无法判断
         跑的是不是最新构建。不显式打开的话这个属性默认不生效，/diag 永远显示未嵌入。 -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 允许测试程序集直接访问 internal 成员（如 ToolArgs 的容错解析分支） -->
    <InternalsVisibleTo Include="CodeAgent.Tests" />
  </ItemGroup>

</Project>
