{
  "provider": "openai",
  "providers": {
    "openai": {
      "type": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "model": "gpt-4o",
      "apiKeyEnv": "OPENAI_API_KEY",
      "maxTokens": 8192,
      "temperature": 0.2
    },
    "deepseek": {
      "type": "openai",
      "baseUrl": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    },
    "qwen": {
      "type": "openai",
      "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "qwen3-coder-plus",
      "apiKeyEnv": "DASHSCOPE_API_KEY"
    },
    "ollama": {
      "type": "openai",
      "baseUrl": "http://localhost:11434/v1",
      "model": "qwen2.5-coder:7b",
      "apiKey": "ollama"
    },
    "hitmargin": {
      "type": "openai",
      "baseUrl": "https://ss2a.top/v1",
      "model": "poolside/laguna-s-2.1:free",
      "apiKey": "dummy"
    },
    "anthropic": {
      "type": "anthropic",
      "model": "claude-sonnet-4-5",
      "apiKeyEnv": "ANTHROPIC_API_KEY"
    }
  },
  "maxToolIterations": 20,
  "maxHistoryChars": 160000,
  "contextWindow": 131072,
  "fileAccess": "strict",
  "readOnlyDirs": [],
  "allowCommands": true,
  "confirmCommands": false,
  "commandTimeoutSeconds": 60,
  "shell": "",
  "saveSessions": true,
  "maxSessionLogs": 30,
  "streamOutput": true,
  "showToolCalls": true,
  "renderMarkdown": true,
  "tuiAnsi": true,
  "thinkingEffort": "off",
  "autoCompactPercent": 0,
  "defaultMode": "code",
  "modes": [
    {
      "name": "fix",
      "description": "修复模式：定位并修复 bug",
      "systemPrompt": "You are CodeAgent in FIX mode. Reproduce the bug, find the root cause, apply a minimal fix, then verify with the build/tests.",
      "tools": ["read_file", "glob", "grep", "run_command", "stop"]
    }
  ]
}
